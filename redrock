#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/common.sh
source "$ROOT/scripts/common.sh"
load_env

CMD="${1:-help}"
shift || true

case "$CMD" in
  status|devices|adb)
    require_adb
    info "adb $($ADB_BIN version | head -n1)  ($ADB_BIN)"
    "$ADB_BIN" start-server >/dev/null
    echo
    "$ADB_BIN" devices -l
    count="$(device_count)"
    echo
    if [[ "$count" -gt 0 ]]; then
      info "$count device(s) ready"
    else
      warn "adb is running, but no headset is connected yet"
    fi
    ;;

  pair)
    host="${1:-}"
    code="${2:-}"
    [[ -n "$host" ]] || die "usage: ./redrock pair <ip:pairing-port> [pairing-code]"
    require_adb
    if [[ -n "$code" ]]; then
      "$ADB_BIN" pair "$host" "$code"
    else
      "$ADB_BIN" pair "$host"
    fi
    info "paired. now: ./redrock connect <ip:connect-port>"
    ;;

  connect)
    target="$(quest_target "${1:-}")"
    require_adb
    "$ADB_BIN" connect "$target"
    info "connected $target"
    "$ADB_BIN" devices -l
    ;;

  disconnect)
    require_adb
    if [[ -n "${1:-}" ]]; then
      "$ADB_BIN" disconnect "$(quest_target "$1")"
    else
      "$ADB_BIN" disconnect
    fi
    ;;

  build)
    require_java
    info "assembleDebug"
    "$ROOT/gradlew" -p "$ROOT" :app:assembleDebug
    mkdir -p "$ROOT/apk"
    cp -f "$ROOT/app/build/outputs/apk/debug/app-debug.apk" "$ROOT/apk/redrock-debug.apk"
    info "apk → apk/redrock-debug.apk"
    ;;

  load|install)
    apk="$(pick_apk "${1:-}")"
    require_device
    info "installing $apk"
    "$ADB_BIN" install -r --user 0 "$apk"
    info "installed. launch with: ./redrock launch"
    ;;

  run)
    "$ROOT/redrock" build
    "$ROOT/redrock" load "$ROOT/apk/redrock-debug.apk"
    "$ROOT/redrock" launch
    ;;

  launch)
    require_device
    pkg="${1:-$PACKAGE}"
    info "starting $pkg"
    "$ADB_BIN" shell monkey -p "$pkg" -c android.intent.category.LAUNCHER 1 >/dev/null
    ;;

  stop)
    require_device
    pkg="${1:-$PACKAGE}"
    "$ADB_BIN" shell am force-stop "$pkg"
    info "stopped $pkg"
    ;;

  uninstall)
    require_device
    pkg="${1:-$PACKAGE}"
    "$ADB_BIN" uninstall "$pkg"
    ;;

  logs|log|logcat)
    require_device
    mkdir -p "$ROOT/logs"
    stamp="$(date +%Y%m%d-%H%M%S)"
    logfile="$ROOT/logs/redrock-$stamp.txt"
    pkg="${1:-}"
    info "logcat → $logfile  (Ctrl-C to stop)"
    if [[ -z "$pkg" ]]; then
      pkg="$PACKAGE"
    fi
    pid="$("$ADB_BIN" shell pidof -s "$pkg" 2>/dev/null | tr -d '\r' || true)"
    if [[ -n "$pid" ]]; then
      info "filtering pid $pid ($pkg)"
      "$ADB_BIN" logcat -v color,time --pid="$pid" | tee "$logfile"
    elif [[ "$pkg" == *"*"* || "$pkg" == *:* ]]; then
      "$ADB_BIN" logcat -v color,time "$pkg" | tee "$logfile"
    else
      warn "package $pkg is not running; showing unfiltered logcat (Unity:Unity *:S also works)"
      "$ADB_BIN" logcat -v color,time | tee "$logfile"
    fi
    ;;

  mods)
    require_device
    sub="${1:-list}"
    shift || true
    case "$sub" in
      list|ls)
        info "mods on headset"
        "$ADB_BIN" shell "run-as $PACKAGE ls -l files/mods 2>/dev/null || echo '(none)'"
        ;;
      push)
        src="${1:-}"
        [[ -n "$src" && -f "$src" ]] || die "usage: ./redrock mods push <file.so>"
        [[ "$src" == *.so ]] || die "mods must be arm64 .so files"
        name="$(basename "$src")"
        info "push $name → files/mods/"
        "$ADB_BIN" shell "run-as $PACKAGE mkdir -p files/mods"
        base64 < "$src" | "$ADB_BIN" shell "run-as $PACKAGE sh -c 'base64 -d > files/mods/$name && chmod 755 files/mods/$name'"
        info "installed $name  (toggle on the toolbox tab, then Play)"
        ;;
      rm|remove)
        name="${1:-}"
        [[ -n "$name" ]] || die "usage: ./redrock mods rm <file.so>"
        "$ADB_BIN" shell "run-as $PACKAGE rm -f files/mods/$name"
        info "removed $name"
        ;;
      *)
        die "usage: ./redrock mods [list|push file.so|rm file.so]"
        ;;
    esac
    ;;

  pull-logs)
    require_device
    mkdir -p "$ROOT/logs"
    dest="$ROOT/logs/logcat-$(date +%Y%m%d-%H%M%S).txt"
    "$ADB_BIN" logcat -d -v time >"$dest"
    info "wrote $dest"
    ;;

  shell)
    require_device
    exec "$ADB_BIN" shell "$@"
    ;;

  help|-h|--help)
    cat <<EOF
RedRock — Oculus Quest sidecar (ADB load + logs)

Usage: ./redrock <command>

  status              Check adb and attached headsets
  pair IP:PORT [CODE] Wireless pairing (Quest Wireless debugging)
  connect [IP[:PORT]] Wireless connect (uses QUEST_HOST from .env)
  disconnect [target] Drop wireless/USB adb session
  build               Gradle assembleDebug → apk/redrock-debug.apk
  load [apk]          Sideload apk/ newest build, or a path
  run                 Build, sideload, and launch
  logs [package]      Follow logcat (saves under logs/)
  mods list           List .so mods on the headset
  mods push file.so   Install an arm64 mcpelauncher-style mod
  mods rm file.so     Remove a mod
  pull-logs           Dump current logcat buffer to logs/
  launch [package]    Start the installed app
  stop [package]      Force-stop the app
  uninstall [package] Remove the installed app
  shell               adb shell on the headset

Drop APKs in apk/. Copy .env.example to .env for wireless host + package name.
EOF
    ;;

  *)
    die "unknown command: $CMD  (try: ./redrock help)"
    ;;
esac

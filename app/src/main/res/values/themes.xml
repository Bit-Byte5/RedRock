<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="RedRockGame" parent="Theme.AppCompat.NoActionBar">
    <item name="android:windowBackground">@color/black</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowFullscreen">true</item>
    <item name="android:backgroundDimEnabled">false</item>
  </style>
  <style name="RedRockWindow" parent="@android:style/Theme.Black.NoTitleBar">
    <item name="android:windowBackground">@color/black</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:backgroundDimEnabled">false</item>
    <item name="android:windowSoftInputMode">adjustResize</item>
  </style>
  <style name="PanelAppThemeTransparent" parent="@android:style/Theme.Black.NoTitleBar">
    <item name="android:windowBackground">@color/black</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:backgroundDimEnabled">false</item>
  </style>
</resources>
